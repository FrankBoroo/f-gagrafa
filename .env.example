# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxx

# Resend (email)
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL="The Gagrafa <bookings@thegagrafa.com>"
ADMIN_NOTIFICATION_EMAIL=team@thegagrafa.com

# WhatsApp (placeholder — wire up Twilio or WhatsApp Business API)
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps embed (homepage + Contact page). Get this from: search your
# exact address on Google Maps -> Share -> "Embed a map" tab -> copy the
# src="..." value out of the iframe code. No API key needed. Falls back to
# a generic "Spintex, Accra" search if left unset.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# Cron (protects /api/cron/reminders — Vercel sends this automatically as a
# Bearer header when CRON_SECRET is set as a project env var)
CRON_SECRET=generate-a-long-random-string
